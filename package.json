{
	"name": "similarity",
	"version": "2.5.2",
	"description": "Search, explore and see related notes based on their meaning. Using a tiny AI running fully on-device: data never leaves your machine, no API keys needed. Great for journalling, or a second brain.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"pretest": "tsc -p tsconfig.build.json",
		"test": "node --test test/*.test.js",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@types/cross-spawn": "^6.0.6",
		"@types/node": "^16.11.6",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"esbuild": "0.17.3",
		"obsidian": "1.13.1",
		"tslib": "2.4.0",
		"typescript": "4.7.4"
	},
	"dependencies": {
		"@huggingface/transformers": "^3.5.0",
		"@types/p-limit": "^2.1.0",
		"@types/turndown": "^5.0.5",
		"p-limit": "^6.1.0",
		"remove-markdown": "^0.5.5",
		"uuid": "^11.1.1"
	},
	"overrides": {
		"sharp": "^0.35.3"
	}
}
